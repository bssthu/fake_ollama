{
  "_": "Portable minimal fake-ollama configuration. Copy to config.json and replace placeholder credentials.",
  "advertised_version": "0.6.4",
  "default_max_tokens": 4096,
  "timeout_seconds": 300.0,
  "use_system_proxy": false,
  "admin_enabled": true,
  "admin_host": "127.0.0.1",
  "admin_port": 21433,
  "dashboard_enabled": true,
  "dashboard_host": "127.0.0.1",
  "dashboard_port": 21432,
  "playground_enabled": false,
  "playground_host": "127.0.0.1",
  "playground_port": 21431,
  "anthropic_upstreams": [
    {
      "name": "anthropic",
      "base_url": "https://api.anthropic.com",
      "auth_token": "sk-ant-replace-me",
      "models": [
        {"name": "claude-example"}
      ]
    }
  ],
  "ollama_interfaces": [
    {
      "name": "ollama",
      "host": "127.0.0.1",
      "port": 21434,
      "access_tokens": [],
      "exposed_models": [
        {"model": "claude-example", "target": "anthropic"}
      ]
    }
  ],
  "api_interfaces": [
    {
      "name": "api",
      "host": "127.0.0.1",
      "port": 21435,
      "access_tokens": ["tk-replace-me-with-a-long-random-string"],
      "exposed_models": [
        {"model": "claude-example", "target": "anthropic", "alias": "claude"}
      ]
    }
  ]
}
