      "estimated_vram_gb": 12.0,
      "estimated_memory_gb": 30.0,
      "thinking_mode": "disabled",
      "show_thinking": false
    }
  ],

  "_interfaces": "==== Interfaces ======================================== 每个数组项都是独立 listener（name/host/port/access_tokens/exposed_models）。ollama_interfaces = Ollama-compatible /api/* + /v1/chat/completions。api_interfaces = Anthropic /v1/messages + OpenAI /v1/chat/completions + /v1/images/* + /v1/models。每个 exposed_models 项为 {model, target, alias?}；填 alias 时 public id 使用 alias，否则使用 'model@target'。",

  "ollama_interfaces": [
    {
      "name": "ollama",
      "host": "127.0.0.1",
      "port": 21434,
      "access_tokens": [],
      "exposed_models": [
        {"model": "claude-3-5-sonnet-20241022", "target": "anthropic"},
        {"model": "deepseek-chat", "target": "deepseek"},
        {"model": "deepseek-r1", "target": "deepseek"},
        {"model": "llama3.1", "target": "local-ollama"},
        {"model": "qwen2.5-coder", "target": "local-ollama"},
        {"model": "qwen3.6-27b-hauhau-q2kp", "target": "qwen3.6-27b-hauhau-q2kp"}
      ]
    }
  ],

  "api_interfaces": [
    {
      "name": "api",
      "host": "127.0.0.1",
      "port": 21435,
      "access_tokens": [
        "tk-replace-me-with-a-long-random-string"
      ],
      "exposed_models": [
        {"model": "claude-3-5-sonnet-20241022", "target": "anthropic", "alias": "claude-sonnet"},
        {"model": "deepseek-chat", "target": "deepseek"},
        {"model": "qwen3.6-27b-hauhau-q2kp", "target": "qwen3.6-27b-hauhau-q2kp"},
        {"model": "z-image-turbo", "target": "z-image-turbo-comfyui", "alias": "z-image-turbo"},
        {"model": "qwen-image", "target": "qwen-image-comfyui", "alias": "qwen-image"},
        {"model": "sensenova", "target": "sensenova-comfyui", "alias": "sensenova-z-image"},
        {"model": "joyai-echo", "target": "joyai-echo-comfyui", "alias": "joyai-echo"}
      ]
    }
  ]
}
