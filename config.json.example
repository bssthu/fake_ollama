{
  "_": "fake-ollama 配置。每个可路由模型都有一个复合 source id：'display@source'，其中 display 是 source 级 alias（没有 alias 时用 name），source 是 upstream / target 配置项的 name。客户端可见的 public id 由每个接口的 exposed_models 决定：填 alias 时使用 alias，否则使用 'model@target'。客户端必须按 public id 请求模型；裸模型名会返回 400。",

  "advertised_version": "0.6.4",

  "default_max_tokens": 4096,
  "timeout_seconds": 300.0,
  "use_system_proxy": false,
  "enforce_context_limit": true,

  "admin_enabled": true,
  "admin_host": "127.0.0.1",
  "admin_port": 21433,

  "dashboard_enabled": true,
  "dashboard_host": "127.0.0.1",
  "dashboard_port": 21432,
  "dashboard_sample_interval_seconds": 10.0,
  "dashboard_retention_seconds": 604800.0,
  "dashboard_data_path": "logs/dashboard_history.json",
  "dashboard_model_reclaim_enabled": false,
  "vram_low_free_reclaim_enabled": true,
  "vram_low_free_threshold_mib": 200.0,

  "playground_enabled": false,
  "playground_host": "127.0.0.1",
  "playground_port": 21431,

  "_model_sources_remote": "==== Remote model sources ==============================",

  "anthropic_upstreams": [
    {
      "name": "anthropic",
      "base_url": "https://api.anthropic.com",
      "auth_token": "sk-ant-...",
      "models": [
        {"name": "claude-3-5-sonnet-20241022"},
        {"name": "claude-3-5-haiku-20241022"}
      ]
    },
    {
      "name": "deepseek",
      "base_url": "https://api.deepseek.com/anthropic",
      "auth_token": "sk-deepseek-...",
      "models": [
        {"name": "deepseek-chat"},
        {"name": "deepseek-reasoner", "alias": "deepseek-r1"}
      ]
    }
  ],

  "openai_upstreams": [
    {
      "name": "deepseek-openai",
      "base_url": "https://api.deepseek.com",
      "auth_token": "sk-deepseek-...",
      "models": [
        {"name": "deepseek-chat"},
        {"name": "deepseek-reasoner"}
      ]
    }
  ],

  "_model_sources_ollama": "==== Ollama sources ====================================",

  "ollama_targets": [
    {
      "name": "local-ollama",
      "base_url": "http://127.0.0.1:11434",
      "models": [
        {"name": "llama3.1:8b", "alias": "llama3.1"},
        {"name": "qwen2.5-coder"}
      ],
      "auto_start": false,
      "start_command": null,
      "stop_command": null,
      "idle_timeout_seconds": null,
      "startup_timeout_seconds": 60,
      "health_path": "/api/version",
      "cwd": null
    }
  ],

  "_model_sources_llama_cpp": "==== llama.cpp sources =================================",

  "llama_cpp_defaults": {
    "auto_start": true,
    "idle_timeout_seconds": 1800,
    "startup_timeout_seconds": 600,
    "health_path": "/health",
    "cwd": "I:\\Projects\\llama.cpp",
    "binary_path": null,
    "runtime_root": null,
    "gpu_layers": 99,
    "ctx_size": null,
    "parallel": 1,
    "batch_size": null,
    "ubatch_size": null,
    "flash_attn": null,
    "cache_type_k": null,
    "cache_type_v": null,
    "extra_args": null
  },

  "llama_cpp_targets": [
    {
      "name": "qwen3.6-27b-hauhau-q2kp",
      "base_url": "http://127.0.0.1:21436",
      "auth_token": "",
      "model": "qwen3.6-27b-hauhau-q2kp",
      "alias": null,
      "upstream_id": null,
      "model_path": "I:\\Projects\\LLM_Models\\Qwen\\Qwen3.6-27B-Uncensored\\Qwen3.6-27B-Uncensored-HauhauCS-Aggressive-Q2_K.gguf",
      "mmproj_path": null,
      "ctx_size": 60000,
      "flash_attn": true,
      "cache_type_k": "q8_0",
      "cache_type_v": "q8_0"
    }
  ],

  "_model_sources_comfyui": "==== ComfyUI media workflow sources ===================== 每个 target 用 preset 选择工作流形态：z_image_turbo、qwen_image_edit_aio、sensenova_u1 或 joyai_echo。workflow bindings 是执行与参数发现的同一事实来源；Playground 只展示当前 workflow 真正绑定的字段。多个 target 可共用同一个 ComfyUI 实例，并由 VRAM 协调器互斥换出。自定义模型使用 API-format workflow + bindings/static_inputs 接入。",

  "comfyui_targets": [
    {
      "name": "z-image-turbo-comfyui",
      "base_url": "http://127.0.0.1:21480",
      "auth_token": "",
      "model": "z-image-turbo",
      "alias": null,
      "upstream_id": null,
      "preset": "z_image_turbo",
      "auto_start": true,
      "start_command": "\"I:\\Projects\\ComfyUI\\ComfyUI-aki-v3\\python\\python.exe\" -s main.py --listen 127.0.0.1 --port 21480",
      "stop_command": null,
      "idle_timeout_seconds": 1800,
      "startup_timeout_seconds": 180,
      "health_path": "/system_stats",
      "cwd": "I:\\Projects\\ComfyUI\\ComfyUI-aki-v3\\ComfyUI",
      "diffusion_model": "z-image-turbo-fp8-e4m3fn.safetensors",
      "diffusion_weight_dtype": "default",
      "text_encoder_model": "qwen_3_4b_fp4_mixed.safetensors",
      "text_encoder_type": "lumina2",
      "text_encoder_device": "default",
      "vae_model": "ae.safetensors",
      "default_width": 1024,
      "default_height": 1024,
      "default_steps": 8,
      "default_cfg": 1.0,
      "default_sampler_name": "res_multistep",
      "default_scheduler": "simple",
      "default_denoise": 1.0,
      "default_edit_denoise": 0.25,
      "default_shift": 3.0,
      "seed_mode": "random",
      "seed": 0,
      "max_batch_size": 2,
      "output_prefix": "fake_ollama/z-image-turbo",
      "image_upscale_method": "lanczos",
      "image_crop": "center",
      "prompt_timeout_seconds": 600,
      "poll_interval_seconds": 0.5
    },
    {
      "name": "qwen-image-comfyui",
      "base_url": "http://127.0.0.1:21480",
      "model": "qwen-image",
      "preset": "qwen_image_edit_aio",
      "auto_start": true,
      "start_command": "\"I:\\Projects\\ComfyUI\\ComfyUI-aki-v3\\python\\python.exe\" -s main.py --listen 127.0.0.1 --port 21480",
      "idle_timeout_seconds": 1800,
      "startup_timeout_seconds": 180,
      "cwd": "I:\\Projects\\ComfyUI\\ComfyUI-aki-v3\\ComfyUI",
      "default_steps": 6,
      "default_cfg": 1.0,
      "default_sampler_name": "euler_ancestral",
      "default_scheduler": "beta",
      "default_denoise": 1.0,
      "default_edit_denoise": 1.0,
      "max_batch_size": 2,
      "output_prefix": "fake_ollama/qwen-image"
    },
    {
      "name": "sensenova-comfyui",
      "base_url": "http://127.0.0.1:21480",
      "model": "sensenova",
      "preset": "sensenova_u1",
      "auto_start": true,
      "start_command": "\"I:\\Projects\\ComfyUI\\ComfyUI-aki-v3\\python\\python.exe\" -s main.py --listen 127.0.0.1 --port 21480",
      "idle_timeout_seconds": 1800,
      "startup_timeout_seconds": 180,
      "cwd": "I:\\Projects\\ComfyUI\\ComfyUI-aki-v3\\ComfyUI",
      "default_steps": 8,
      "default_cfg": 1.0,
      "max_batch_size": 2,
      "output_prefix": "fake_ollama/sensenova"
    },
    {
      "name": "joyai-echo-comfyui",
      "base_url": "http://127.0.0.1:21480",
      "model": "joyai-echo",
      "preset": "joyai_echo",
      "auto_start": true,
      "start_command": "set \"PATH=I:\\Projects\\Tools\\ffmpeg;%PATH%\" && \"I:\\Projects\\ComfyUI\\ComfyUI-aki-v3\\python\\python.exe\" -s main.py --listen 127.0.0.1 --port 21480",
      "idle_timeout_seconds": 1800,
      "startup_timeout_seconds": 240,
      "cwd": "I:\\Projects\\ComfyUI\\ComfyUI-aki-v3\\ComfyUI",
      "min_width": 256,
      "default_width": 256,
      "width_modulo": 32,
      "min_height": 256,
      "default_height": 256,
      "height_modulo": 32,
      "min_num_frames": 17,
      "default_num_frames": 17,
      "max_num_frames": 241,
      "num_frames_offset": 1,
      "num_frames_modulo": 8,
      "min_frame_rate": 8.0,
      "default_frame_rate": 8.0,
      "max_frame_rate": 120.0,
      "default_prefetch_count": 1,
      "max_prefetch_count": 48,
      "default_enable_tile": true,
      "default_enable_streaming": false,
      "max_reference_images": 5,
      "max_batch_size": 1,
      "output_prefix": "fake_ollama/joyai-echo",
      "prompt_timeout_seconds": 7200,
      "poll_interval_seconds": 1.0
    }
  ],

  "_profiles": "==== Model profiles ==================================== 数组项格式为 {model, target?, ...}，与 exposed_models 对应。只写 model 表示匹配所有 target；同时写 model + target 只覆盖该组合。查找优先级：model@target > bare model > tagless base。capabilities 是对外功能发现标签：completion 文本/聊天补全，tools tool calling，vision 聊天接口可接收图片输入，image_generation /v1/images/generations 图片生成，image_edit /v1/images/edits image-to-image / edit，video_generation /v1/videos/generations 视频或图生视频。",

  "model_profiles": [
    {
      "model": "claude-3-5-sonnet-20241022",
      "capabilities": ["completion", "tools", "vision"],
      "context_length": 200000,
      "max_output_tokens": 8192,
      "thinking_mode": "auto",
      "thinking_budget_tokens": 2048,
      "show_thinking": true
    },
    {
      "model": "deepseek-reasoner",
      "target": "deepseek",
      "capabilities": ["completion", "tools"],
      "context_length": 65536,
      "max_output_tokens": 8192,
      "thinking_mode": "enabled",
      "thinking_budget_tokens": 4096,
      "show_thinking": true
    },
    {
      "model": "deepseek-reasoner",
      "target": "deepseek-openai",
      "capabilities": ["completion", "tools"],
      "context_length": 65536,
      "max_output_tokens": 8192,
      "thinking_mode": "disabled",
      "show_thinking": false
    },
    {
      "model": "llama3.1",
      "capabilities": ["completion", "tools"],
      "context_length": 131072,
      "estimated_vram_gb": 6.0
    },
    {
