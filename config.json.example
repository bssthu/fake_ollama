{
  "_": "fake-ollama configuration. Each model the proxy can route to has a composite source id 'display@source' where 'display' is the source-level alias (or name if no alias) and 'source' is the name of the upstream / target entry. Public ids are decided per-interface in 'exposed_models' (alias if set, otherwise 'model@target'). Clients must request models by their public id; bare model names are rejected with 400.",

  "advertised_version": "0.6.4",

  "default_max_tokens": 4096,
  "timeout_seconds": 300.0,
  "use_system_proxy": false,
  "enforce_context_limit": true,

  "admin_enabled": true,
  "admin_host": "127.0.0.1",
  "admin_port": 21433,

  "dashboard_enabled": true,
  "dashboard_host": "127.0.0.1",
  "dashboard_port": 21432,
  "dashboard_sample_interval_seconds": 10.0,
  "dashboard_retention_seconds": 604800.0,
  "dashboard_data_path": "logs/dashboard_history.json",
  "dashboard_model_reclaim_enabled": false,
  "vram_low_free_reclaim_enabled": true,
  "vram_low_free_threshold_mib": 200.0,

  "_model_sources_remote": "==== Remote model sources ==============================",

  "anthropic_upstreams": [
    {
      "name": "anthropic",
      "base_url": "https://api.anthropic.com",
      "auth_token": "sk-ant-...",
      "models": [
        {"name": "claude-3-5-sonnet-20241022"},
        {"name": "claude-3-5-haiku-20241022"}
      ]
    },
    {
      "name": "deepseek",
      "base_url": "https://api.deepseek.com/anthropic",
      "auth_token": "sk-deepseek-...",
      "models": [
        {"name": "deepseek-chat"},
        {"name": "deepseek-reasoner", "alias": "deepseek-r1"}
      ]
    }
  ],

  "openai_upstreams": [
    {
      "name": "deepseek-openai",
      "base_url": "https://api.deepseek.com",
      "auth_token": "sk-deepseek-...",
      "models": [
        {"name": "deepseek-chat"},
        {"name": "deepseek-reasoner"}
      ]
    }
  ],

  "_model_sources_ollama": "==== Ollama sources ====================================",

  "ollama_targets": [
    {
      "name": "local-ollama",
      "base_url": "http://127.0.0.1:11434",
      "models": [
        {"name": "llama3.1:8b", "alias": "llama3.1"},
        {"name": "qwen2.5-coder"}
      ],
      "auto_start": false,
      "start_command": null,
      "stop_command": null,
      "idle_timeout_seconds": null,
      "startup_timeout_seconds": 60,
      "health_path": "/api/version",
      "cwd": null
    }
  ],

  "_model_sources_llama_cpp": "==== llama.cpp sources =================================",

  "llama_cpp_defaults": {
    "auto_start": true,
    "idle_timeout_seconds": 1800,
    "startup_timeout_seconds": 600,
    "health_path": "/health",
    "cwd": "I:\\Projects\\llama.cpp",
    "binary_path": null,
    "runtime_root": null,
    "gpu_layers": 99,
    "ctx_size": null,
    "parallel": 1,
    "batch_size": null,
    "ubatch_size": null,
    "flash_attn": null,
    "cache_type_k": null,
    "cache_type_v": null,
    "extra_args": null
  },

  "llama_cpp_targets": [
    {
      "name": "qwen3.6-27b-hauhau-q2kp",
      "base_url": "http://127.0.0.1:21436",
      "auth_token": "",
      "model": "qwen3.6-27b-hauhau-q2kp",
      "alias": null,
      "upstream_id": null,
      "model_path": "I:\\Projects\\LLM_Models\\Qwen\\Qwen3.6-27B-Uncensored\\Qwen3.6-27B-Uncensored-HauhauCS-Aggressive-Q2_K.gguf",
      "mmproj_path": null,
      "ctx_size": 60000,
      "flash_attn": true,
      "cache_type_k": "q8_0",
      "cache_type_v": "q8_0"
    }
  ],

  "_profiles": "==== Model profiles ==================================== Array of {model, target?, ...} entries (mirrors exposed_models). 'model' alone matches all targets; 'model'+'target' overrides only that pairing. Lookup is most-specific first: model@target > bare model > tagless base.",

  "model_profiles": [
    {
      "model": "claude-3-5-sonnet-20241022",
      "capabilities": ["completion", "tools", "vision"],
      "context_length": 200000,
      "max_output_tokens": 8192,
      "thinking_mode": "auto",
      "thinking_budget_tokens": 2048,
      "show_thinking": true
    },
    {
      "model": "deepseek-reasoner",
      "target": "deepseek",
      "capabilities": ["completion", "tools"],
      "context_length": 65536,
      "max_output_tokens": 8192,
      "thinking_mode": "enabled",
      "thinking_budget_tokens": 4096,
      "show_thinking": true
    },
    {
      "model": "deepseek-reasoner",
      "target": "deepseek-openai",
      "capabilities": ["completion", "tools"],
      "context_length": 65536,
      "max_output_tokens": 8192,
      "thinking_mode": "disabled",
      "show_thinking": false
    },
    {
      "model": "llama3.1",
      "capabilities": ["completion", "tools"],
      "context_length": 131072,
      "estimated_vram_gb": 6.0
    },
    {
      "model": "qwen3.6-27b-hauhau-q2kp",
      "capabilities": ["completion", "tools"],
      "context_length": 60000,
      "estimated_vram_gb": 18.0,
      "thinking_mode": "disabled",
      "show_thinking": false
    }
  ],

  "_interfaces": "==== Interfaces ======================================== Each interface array entry is an independent listener (name/host/port/access_tokens/exposed_models). 'ollama_interfaces' = Ollama-compatible /api/* + /v1/chat/completions. 'api_interfaces' = Anthropic /v1/messages + OpenAI /v1/chat/completions + /v1/models. Each exposed_models entry is {model, target, alias?}; public id = alias if set, else 'model@target'.",

  "ollama_interfaces": [
    {
      "name": "ollama",
      "host": "127.0.0.1",
      "port": 21434,
      "access_tokens": [],
      "exposed_models": [
        {"model": "claude-3-5-sonnet-20241022", "target": "anthropic"},
        {"model": "deepseek-chat", "target": "deepseek"},
        {"model": "deepseek-r1", "target": "deepseek"},
        {"model": "llama3.1", "target": "local-ollama"},
        {"model": "qwen2.5-coder", "target": "local-ollama"},
        {"model": "qwen3.6-27b-hauhau-q2kp", "target": "qwen3.6-27b-hauhau-q2kp"}
      ]
    }
  ],

  "api_interfaces": [
    {
      "name": "api",
      "host": "127.0.0.1",
      "port": 21435,
      "access_tokens": [
        "tk-replace-me-with-a-long-random-string"
      ],
      "exposed_models": [
        {"model": "claude-3-5-sonnet-20241022", "target": "anthropic", "alias": "claude-sonnet"},
        {"model": "deepseek-chat", "target": "deepseek"},
        {"model": "qwen3.6-27b-hauhau-q2kp", "target": "qwen3.6-27b-hauhau-q2kp"}
      ]
    }
  ]
}
