      "show_thinking": false
    },
    {
      "model": "z-image-turbo",
      "target": "z-image-turbo-comfyui",
      "capabilities": ["image_generation", "image_edit"],
      "context_length": 4096,
      "estimated_vram_gb": 16.0,
      "thinking_mode": "disabled",
      "show_thinking": false
    },
    {
      "model": "qwen-image",
      "target": "qwen-image-comfyui",
      "capabilities": ["image_generation", "image_edit"],
      "context_length": 4096,
      "estimated_vram_gb": 20.0,
      "thinking_mode": "disabled",
      "show_thinking": false
    },
    {
      "model": "sensenova",
      "target": "sensenova-comfyui",
      "capabilities": ["image_generation", "image_edit"],
      "context_length": 4096,
      "estimated_vram_gb": 13.0,
      "estimated_memory_gb": 30.0,
      "thinking_mode": "disabled",
      "show_thinking": false
    },
    {
      "model": "joyai-echo",
      "target": "joyai-echo-comfyui",
