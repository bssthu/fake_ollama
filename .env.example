# Test-only environment variables for fake-ollama.
#
# Runtime configuration lives entirely in config.json (see
# config.json.example). The variables below are consumed ONLY by the
# test suite and are not read by the running server.

# ---- Live integration tests (tests/test_integration.py) ------------------
# Presence signal: when both are set, integration tests run against the
# upstream that is currently configured in config.json. The values are
# checked only with bool(); they are not parsed as URL/token themselves.
# FAKE_OLLAMA_TEST_BASE_URL=1
# FAKE_OLLAMA_TEST_AUTH_TOKEN=1

# ---- Optional: alternate config file used by ad-hoc test runs ------------
# FAKE_OLLAMA_CONFIG=./config.test.json
