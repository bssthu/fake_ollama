# Environment-variable reference for fake-ollama.
#
# Neither the server nor pytest loads .env automatically. Set variables in
# the launching process, for example in PowerShell:
# $env:FAKE_OLLAMA_CONFIG = './config.test.json'
# Model routes, listeners and credentials belong in JSON, not this file.

# ---- Server / test configuration file ----------------------------------
# Used by the running server as well as tests that load settings.
# CLI --config takes precedence; otherwise defaults to ./config.json.
# FAKE_OLLAMA_CONFIG=./config.test.json
# Enable privacy with the CLI --privacy-mode switch; the server propagates
# FAKE_OLLAMA_PRIVACY_MODE internally to its managed workers.

# ---- Live integration tests (tests/integration/test_live_upstream.py) ---
# Default pytest excludes integration tests; select them with -m integration.
# Presence signal: when both are set, integration tests run against the
# upstream in the active JSON config (FAKE_OLLAMA_CONFIG or ./config.json).
# Select a dedicated test configuration before opting in. The values are
# checked only with bool(); they are not parsed as URL/token themselves.
# FAKE_OLLAMA_TEST_BASE_URL=1
# FAKE_OLLAMA_TEST_AUTH_TOKEN=1
