{
  "_": "Windows 本地多模型部署示例。路径均为示例值，复制后按本机环境调整。",

  "advertised_version": "0.6.4",

  "default_max_tokens": 4096,
  "timeout_seconds": 300.0,
  "use_system_proxy": false,
  "enforce_context_limit": true,

  "admin_enabled": true,
  "admin_host": "127.0.0.1",
  "admin_port": 21433,

  "dashboard_enabled": true,
  "dashboard_host": "127.0.0.1",
  "dashboard_port": 21432,
  "dashboard_sample_interval_seconds": 10.0,
  "dashboard_retention_seconds": 604800.0,
  "dashboard_data_path": "logs/dashboard_history.json",
  "dashboard_model_reclaim_enabled": false,
  "vram_low_free_reclaim_enabled": true,
  "vram_low_free_threshold_mib": 200.0,

  "playground_enabled": false,
  "playground_host": "127.0.0.1",
  "playground_port": 21431,

  "_model_sources_remote": "==== Remote model sources ==============================",

  "anthropic_upstreams": [
    {
      "name": "anthropic",
      "base_url": "https://api.anthropic.com",
      "auth_token": "sk-ant-...",
      "models": [
        {"name": "claude-3-5-sonnet-20241022"},
        {"name": "claude-3-5-haiku-20241022"}
      ]
    },
    {
      "name": "deepseek",
      "base_url": "https://api.deepseek.com/anthropic",
      "auth_token": "sk-deepseek-...",
      "models": [
        {"name": "deepseek-chat"},
        {"name": "deepseek-reasoner", "alias": "deepseek-r1"}
      ]
    }
  ],

  "openai_upstreams": [
    {
      "name": "deepseek-openai",
      "base_url": "https://api.deepseek.com",
      "auth_token": "sk-deepseek-...",
      "models": [
        {"name": "deepseek-chat"},
        {"name": "deepseek-reasoner"}
      ]
    }
  ],

  "_model_sources_ollama": "==== Ollama sources ====================================",

  "ollama_targets": [
    {
      "name": "local-ollama",
      "base_url": "http://127.0.0.1:11434",
      "models": [
        {"name": "llama3.1:8b", "alias": "llama3.1"},
        {"name": "qwen2.5-coder"}
      ],
      "auto_start": false,
      "start_command": null,
      "stop_command": null,
      "idle_timeout_seconds": null,
      "startup_timeout_seconds": 60,
      "health_path": "/api/version",
      "cwd": null
    }
  ],

  "_model_sources_generic_openai": "==== Lifecycle-managed OpenAI-compatible sources ====== Mage-VL 示例使用 services\\mage_vl 中的独立视频分析服务。先运行 services\\mage_vl\\scripts\\install.ps1；服务按首个请求自动启动并在空闲后优雅退出。",

  "generic_openai_targets": [
    {
      "name": "mage-vl-local-adapter",
      "base_url": "http://127.0.0.1:8071",
      "auth_token": "",
      "models": [
        {"name": "mage-vl-local"}
      ],
      "auto_start": true,
      "start_command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"services\\mage_vl\\scripts\\start.ps1\"",
      "stop_command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"services\\mage_vl\\scripts\\stop.ps1\"",
      "idle_timeout_seconds": 1800,
      "startup_timeout_seconds": 120,
      "health_path": "/health",
      "cwd": ".",
      "max_concurrent_requests": 1,
      "request_read_timeout_seconds": 0
    }
  ],

