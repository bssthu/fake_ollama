  "_h3_context_ir": "==== H3 Context IR harness ============================= Provider references reuse existing model + target routes. The standalone virtual model is visible only in Playground; a ComfyUI video target may opt in through context_ir_profile.",

  "h3_context_ir_profiles": [
    {
      "name": "default",
      "alias": "h3-context-ir-fake",
      "enabled": true,
      "playground_visible": true,
      "allow_compatible_models": true,
      "allow_external_api": false,
      "providers": [
        {
          "name": "local-text",
          "model": "qwen3.6-27b-hauhau-q2kp",
          "target": "qwen3.6-27b-hauhau-q2kp",
          "modalities": ["text"],
          "json_mode": true
        },
        {
          "name": "local-vision",
          "model": "mage-vl-local",
          "target": "mage-vl-local-adapter",
          "modalities": ["text", "image"],
          "json_mode": false
        },
        {
          "name": "remote-api",
          "model": "deepseek-chat",
          "target": "deepseek-openai",
          "modalities": ["text"],
          "json_mode": true
        }
      ],
      "default_text_provider": "local-text",
      "default_multimodal_provider": "local-vision",
      "temperature": 0.2,
      "max_output_tokens": 4096,
      "max_attempts": 2,
      "failure_mode": "fallback",
      "default_duration_seconds": 5.0
    }
  ],

  "_profiles": "==== Model profiles ==================================== 数组项格式为 {model, target?, ...}，与 exposed_models 对应。只写 model 表示匹配所有 target；同时写 model + target 只覆盖该组合。查找优先级：model@target > bare model > tagless base。capabilities 是对外功能发现标签：completion 文本/聊天补全，tools tool calling，vision 聊天接口可接收图片输入，video_understanding /v1/chat/completions 接收本地视频分析，image_generation /v1/images/generations 图片生成，image_edit /v1/images/edits image-to-image / edit，video_generation /v1/videos/generations 视频或图生视频。",

